{
  "name": "Python 3",
  // Pinned to 3.11 on purpose: it matches the middle of the CI matrix, so a
  // Codespace reproduces what CI sees. It does NOT match Streamlit Cloud, which
  // currently runs 3.14 — no devcontainers image is published for 3.14 yet, so
  // an exact match is not available. Version-specific breakage in production
  // will not reproduce here; check the deployment logs for those.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "OneDrive/Desktop/stock-valuation-predictor/app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // The project lives in a subfolder, so packages.txt / requirements.txt are
  // not at the repo root where the Codespaces default template looks for them.
  // The template's `[ -f requirements.txt ] &&` guard fails silently, which
  // installs nothing and leaves the app to die on its first import.
  "updateContentCommand": "cd OneDrive/Desktop/stock-valuation-predictor && { [ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; true; } && pip3 install --user -r requirements.txt && pip3 install --user streamlit && echo '✅ Packages installed and Requirements met'",
  "postAttachCommand": {
    "server": "streamlit run OneDrive/Desktop/stock-valuation-predictor/app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}